# FOLD STUDIO ENVIRONMENT CONFIGURATION
# Copy to .env for local development. Never commit real values.
# Full setup guide: docs/INQUIRY_AUTOMATION.md

# Server Port (Default: 5001)
PORT=5001

# ---------------------------------------------------------------
# Inquiry database
# ---------------------------------------------------------------
# Production: a PostgreSQL URL (Supabase / Neon / Render Postgres).
# Leave unset locally to use server/inquiries.local.db (SQLite, dev only).
DATABASE_URL=
# CA certificate of the database (Supabase → Database → SSL Configuration → Download certificate).
# Paste the whole PEM, including the BEGIN/END lines. Required for Supabase.
DATABASE_CA_CERT=
# Optional: separate DB just for inquiries (overrides DATABASE_URL), e.g. sqlite::memory:
DATABASE_URL_INQUIRIES=

# ---------------------------------------------------------------
# Email delivery (Resend) — server-side only
# ---------------------------------------------------------------
# https://resend.com/api-keys  (use a "Sending access" key)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "FOLD Studio <inquiries@yourdomain.com>".
# onboarding@resend.dev only delivers to the email that owns the Resend account.
EMAIL_FROM="FOLD Studio <onboarding@resend.dev>"
# Where new inquiries are delivered
EMAIL_TO="enquiryfoldstudio@gmail.com"
# Send the customer an acknowledgement email (needs a verified domain)
SEND_CLIENT_CONFIRMATION=false
# Resend → Webhooks → signing secret (whsec_...), endpoint: https://<host>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Team dashboard, reminders and scheduled processing
# ---------------------------------------------------------------
# Public URL of the deployed site (used for dashboard links in emails)
APP_BASE_URL=https://your-fold-site.example
# Dashboard at /admin. 24+ random characters: openssl rand -base64 32
ADMIN_TOKEN=
# External cron calls POST /api/cron/inquiries with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Reminder for inquiries still NEW after this many hours
REMINDER_UNREVIEWED_HOURS=24
# Internal follow-up reminder this many business days after QUOTATION SENT
QUOTATION_FOLLOWUP_BUSINESS_DAYS=3

# Team members per role: "Name" or "Name <email>". Reminders go to the owner's email,
# or to EMAIL_TO when none is set.
TEAM_CLIENT_MANAGER="Likhitha"
TEAM_SOCIAL_MEDIA_MANAGER="Ganesh"
TEAM_DESIGNER="Dakesh"
TEAM_DEVELOPER="Ganesh"
TEAM_ASSISTANT_DEVELOPER="Manikanta"

# Tuning (defaults shown)
EMAIL_MAX_ATTEMPTS=6
EMAIL_RETRY_BASE_MS=30000
EMAIL_POLL_INTERVAL_MS=60000
INQUIRY_RATE_MAX=5
INQUIRY_RATE_WINDOW_MS=600000

# ---------------------------------------------------------------
# Frontend (only if the site is hosted separately from the Express server)
# ---------------------------------------------------------------
# e.g. https://fold-studio.onrender.com/api
VITE_API_BASE_URL=

# FOLD STUDIO ENVIRONMENT CONFIGURATION

# Server Port (Default: 5001)
PORT=5001

# Production Transactional Email API Key (Resend)
# Get your API Key from https://resend.com
RESEND_API_KEY=

# Verified Sender Email Address (Follows domain verification on Resend)
EMAIL_FROM="FOLD Studio <onboarding@resend.dev>"

# Destination Recipient Email Address for Project Inquiries
INQUIRY_RECIPIENT="enquiryfoldstudio@gmail.com"

# Web3Forms Access Key for Static Hosting (https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY="YOUR_WEB3FORMS_ACCESS_KEY"

# Optional SMTP Configuration for Nodemailer (Backend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

